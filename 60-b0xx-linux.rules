# Lets members of the "input" group create virtual devices (needed for the
# emulated controller). Reading keyboards already works for that group.
# Install: sudo cp 60-b0xx-linux.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
